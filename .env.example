# Paikallinen kehitys ei tarvitse Redis-tä. Vercelissä nämä ovat pakolliset.
# Luo ilmainen Upstash Redis (Vercel Marketplace → Upstash) ja liitä projektiin.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tekoäly: xAI Grok (Vercel Secret / env)
GROK_TOKEN=
# Valinnainen ohitus:
# GROK_MODEL=grok-3-mini

# Valinnainen: Instagram-selaimen sessionid (parantaa somearvojen hakua Vercelissä)
# Chrome → instagram.com → Application → Cookies → sessionid
# IG_SESSIONID=
